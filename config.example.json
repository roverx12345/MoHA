{
  "schema": "moha_config_v1",
  "diagnosis_workers": 8,
  "perception_calibration": true,
  "media_root": "/path/to/video/root",
  "calibration_manifest": "/path/to/calibration_input_manifest.json",
  "validation_manifest": "/path/to/validation_input_manifest.json",
  "initial": {
    "max_steps": 16,
    "history_turns": 8,
    "history_tokens": 18000
  },
  "search": {
    "max_rounds": 5,
    "candidates_per_round": 2,
    "patience": 2,
    "failure_stability": 0.1,
    "min_diagnosis_coverage": 0.5,
    "max_diagnosis_error_rate": 0.2
  },
  "validation": {
    "repeats": 2,
    "min_gain": 0.02,
    "cost_metric": "video_tokens",
    "cost_penalty": 0.0,
    "max_cost_ratio": null,
    "require_positive_interval": false,
    "require_each_repeat_nonnegative": false
  },
  "budget": {
    "c_text_max": null,
    "c_sensor_max": null,
    "b_control": null,
    "b_video": 16384,
    "b_state": null,
    "b_task": null,
    "f_view": 128,
    "p_view": 262144,
    "p_call": 33554432,
    "k_look": 8,
    "k_compare": 2,
    "f_episode": 256,
    "b_video_episode": 65536
  },
  "models": {
    "planner": {
      "spec": {
        "model": "planner-model",
        "base_url": "https://planner.example.invalid/v1",
        "max_completion_tokens": 2048,
        "timeout_seconds": 900,
        "retries": 0
      },
      "key": {
        "env": "MOHA_PLANNER_API_KEY"
      }
    },
    "judge": {
      "spec": {
        "model": "judge-model",
        "base_url": "https://judge.example.invalid/v1",
        "response_format_mode": "json_text",
        "max_completion_tokens": 4096,
        "timeout_seconds": 900,
        "retries": 0
      },
      "key": {
        "env": "MOHA_JUDGE_API_KEY"
      }
    }
  },
  "observer": {
    "backend": "qwen3omni",
    "model": "Qwen3-Omni-30B-A3B-Instruct",
    "base_url": "http://127.0.0.1:8097/v1",
    "key": {
      "local": true
    },
    "timeout_seconds": 600,
    "retries": 0
  },
  "specialists": [
    "ocr",
    "asr"
  ],
  "image": {
    "spec": {
      "model": "ocr-model",
      "base_url": "https://ocr.example.invalid/v1",
      "timeout_seconds": 300,
      "retries": 0,
      "max_completion_tokens": 3072,
      "enable_thinking": false
    },
    "key": {
      "env": "MOHA_OCR_API_KEY"
    }
  },
  "asr": {
    "spec": {
      "model": "whisper-large-v3-turbo",
      "base_url": "http://127.0.0.1:8093/v1",
      "timeout_seconds": 300,
      "retries": 0
    },
    "key": {
      "local": true
    },
    "language": null
  },
  "retrieval_extension": false,
  "runtime": {
    "root": "/path/to/flat",
    "commit": "REPLACE_WITH_THE_PINNED_FLAT_COMMIT"
  }
}
